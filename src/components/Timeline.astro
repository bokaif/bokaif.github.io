---
import data from "../data/experience.json";

const { experienceSection } = data;
const { experienceGroup, leadershipGroup, sidebar } = experienceSection.layout;
const MAX_TECH_TAGS = 5;
---

<section class="panel section-card">
  <div class="section-title-stack">
    <p class="group-title">{experienceSection.label}</p>
    <p>{experienceGroup.description}</p>
  </div>

  <div class="experience-layout">
    <div class="experience-main">
      <div class="experience-group">
        <div class="timeline">
          {experienceGroup.items.map((item, index) => {
            const hiddenTechCount = Math.max(0, item.tech.length - MAX_TECH_TAGS);
            const highlights = item.highlights && item.highlights.length ? item.highlights : [item.description];

            return (
              <div class="timeline-entry">
                <div class="timeline-marker">
                  <span class:list={["timeline-dot", { "active-dot": index === 0 }]}></span>
                  {index < experienceGroup.items.length - 1 && <span class="timeline-line"></span>}
                </div>
                <div class="timeline-content">
                  <div class="timeline-header">
                    <h3>{item.title}</h3>
                    {item.badge ? (
                      <span class="timeline-badge">{item.badge}</span>
                    ) : (
                      <span class="timeline-date"></span>
                    )}
                  </div>
                  <p class="timeline-org">{item.organization} · {item.location} · {item.date}</p>
                  <div class="timeline-tech" aria-label="Tech stack">
                    {item.tech.map((tech, techIndex) => (
                      <span class:list={["timeline-tech-chip", { "timeline-tech-hidden": techIndex >= MAX_TECH_TAGS }]}>{tech}</span>
                    ))}
                    {hiddenTechCount > 0 && (
                      <button
                        type="button"
                        class="timeline-tech-overflow timeline-tech-toggle"
                        data-collapsed-label={`+${hiddenTechCount}`}
                        aria-expanded="false"
                      >
                        +{hiddenTechCount}
                      </button>
                    )}
                  </div>
                  <ul class="timeline-highlights">
                    {highlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <div class="experience-group leadership-group">
        <div class="experience-group-heading">
          <p class="group-title">{leadershipGroup.title}</p>
          {leadershipGroup.description && <p>{leadershipGroup.description}</p>}
        </div>

        <div class="leadership-grid">
          {leadershipGroup.items.map((item) => (
            <article class="leadership-card">
              <div class="leadership-copy">
                <div class="leadership-card-top">
                  <span class="leadership-tag">{item.tag}</span>
                  <p class="leadership-date">{item.date}</p>
                </div>
                <h3>{item.title}</h3>
                <p class="leadership-org">{item.organization}</p>
                {item.tech && (
                  <div class="leadership-tech" aria-label="Skills">
                    {item.tech.map((tech) => <span>{tech}</span>)}
                  </div>
                )}
                {item.description && <p class="leadership-desc">{item.description}</p>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>

    <aside class="experience-sidebar">
      <div class="experience-note">
        <p class="group-title">{sidebar.title}</p>
        <div class="award-list">
          {sidebar.items.map((item) => (
            <article class="award-item">
              <div class="award-item-top">
                <span class="award-icon">
                  <span class="iconify" data-icon={item.icon}></span>
                </span>
                <div class="award-copy">
                  <p class="award-title">{item.title}</p>
                  <p class="award-meta">{item.meta}</p>
                  {item.url && (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="award-link">
                  Read feature
                  <span class="iconify" data-icon="lucide:external-link" data-inline="false"></span>
                </a>
              )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </aside>
  </div>
</section>
