---
const educationItems = [
  {
    period: "2024 — 2027",
    school: "BRAC University",
    program: "Bachelor of Science, Computer Science",
    activities: "Computer Club, Research Club",
  },
  {
    period: "2022 — 2023",
    school: "Notre Dame College",
    program: "Science",
    activities: "Technology Club, Math Club",
  },
  {
    period: "2011 — 2021",
    school: "Ideal School and College",
    program: "Science",
    activities: "Scout, Technology Club",
  },
];
---

<section class="panel section-card">
  <div class="section-title-stack">
    <p class="group-title">About</p>
  </div>

  <div class="about-grid">
    <div class="about-copy">
      <p class="about-lead">
        Hi, I'm <span class="about-name">Kaif</span>. I design and build systems that are reliable and easy to use.
      </p>
      <div class="about-body">
        <p>
          I work mostly around <strong>Applied AI</strong> and <strong>Product Engineering</strong>, with a focus on delivering polished systems.
        </p>
        <p>
          Currently, I'm studying <strong>Computer Science</strong> at <strong>BRAC University</strong>, set to graduate in late 2027.
        </p>
        <p>
          My journey as a software engineer started right out of high school. I learned by building things end to end and debugging my way through them. That's still how I approach engineering.
        </p>
      </div>
    </div>

    <aside class="about-visual" aria-label="Portrait">
      <div class="about-visual-card">
        <div class="about-visual-backdrop" aria-hidden="true"></div>
        <div class="about-visual-frame">
          <img src="/images/5.png" alt="Portrait of Badruddoza Kaif" />
        </div>
      </div>
    </aside>
  </div>

  <div class="about-education">
    <div class="about-education-heading">
      <p class="group-title">Education</p>
    </div>

    <div class="about-education-list">
      {educationItems.map((item) => (
        <article class="about-education-item">
          <p class="about-education-period">{item.period}</p>
          <div class="about-education-copy">
            <p class="about-education-school">{item.school}</p>
            <p class="about-education-program">{item.program}</p>
          </div>
          <div class="about-education-side">
            <p class="about-education-side-label">Clubs & societies</p>
            <p class="about-education-activities">{item.activities}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
