---
const projects = [
  {
    title: "StudySmart",
    href: "https://github.com/bokaif/StudySmart",
    tag: "Hackathon",
    summary: "Grounded AI learning platform for university courses with chat, retrieval, digitization, and analytics.",
    tech: ["Next.js", "FastAPI", "Firebase", "ChromaDB", "Gemini"],
    image: "/images/projects/studysmart.webp",
  },
  {
    title: "Mimic Me",
    href: "https://github.com/bokaif/mimic-me",
    tag: "Automation",
    summary: "Brutalist desktop macro tool for recording, replaying, and saving repetitive keyboard and mouse workflows.",
    tech: ["Python", "CustomTkinter", "Tkinter", "Pynput"],
    image: "/images/projects/mimic-me.webp",
  },
  {
    title: "Landsat Lens",
    href: "https://github.com/bokaif/landsat-lens",
    tag: "NASA",
    summary: "Web app for tracking Landsat passes, viewing reflectance overlays, and sending next-pass reminders.",
    tech: ["React", "TypeScript", "Flask", "Leaflet", "Skyfield"],
    image: "/images/projects/landsat-lens.webp",
  },
  {
    title: "Astrobee Controller",
    href: "https://github.com/bokaif/astrobee-controller",
    tag: "JAXA",
    summary: "ISS robotics project using quaternion movement, tool detection, and AR-code mission execution on Astrobee.",
    tech: ["Java", "TensorFlow", "OpenCV", "ZXing", "Gradle"],
    image: "/images/projects/krpc.webp",
  },
  {
    title: "WhyFakeIt",
    href: "https://github.com/bokaif/whyfakeit",
    tag: "NLP",
    summary: "Bangla fake news detection system for classifying misinformation through a lightweight web interface.",
    tech: ["Python", "NLP", "Flask", "HTML", "JavaScript"],
    image: "/images/projects/whyfakeit.webp",
  },
];
---

<section class="panel section-card">
  <div class="section-title-stack">
    <p class="group-title">Projects</p>
    <p>Selected work across AI systems, automation, space tech, and language tools.</p>
  </div>

  <div class="projects-grid">
    {projects.map((project) => (
      <a href={project.href} target="_blank" rel="noopener noreferrer" class="project-card">
        <div class="project-media">
          <span class="project-tag">{project.tag}</span>
          <img src={project.image} alt={`${project.title} preview`} loading="lazy" />
        </div>

        <div class="project-content">
          <h3>
            {project.title}
            <span class="project-open-link" aria-hidden="true">
              <span class="iconify" data-icon="lucide:arrow-up-right" data-inline="false"></span>
            </span>
          </h3>
          <p>{project.summary}</p>

          <div class="project-tech">
            {project.tech.map((item) => <span>{item}</span>)}
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
