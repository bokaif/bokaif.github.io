---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="bokaif — dev, designer, dumbest being" />
    <title>bokaif</title>
    <link rel="icon" type="image/svg+xml" href="/images/bokaif.svg" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.3/gsap.min.js" defer></script>
    <script src="https://code.iconify.design/2/2.2.1/iconify.min.js" defer></script>
  </head>
  <body>
    <div id="window">
      <div id="random-photos"></div>
      <header id="topbar">
        <a href="#hero" class="topbar-logo">
          <img src="/images/bokaif.svg" alt="bokaif" draggable="false" />
        </a>
        <div class="topbar-right">
          <a href="#" id="topbar-email-link" aria-label="Copy email" class="social-pill">
            <span class="iconify email-icon" data-icon="mdi:email" data-inline="false"></span>
            <span class="iconify check-icon" data-icon="lucide:clipboard-copy" data-inline="false" style="display: none;"></span>
          </a>
          <a href="https://github.com/bokaif" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-pill">
            <span class="iconify" data-icon="mdi:github"></span>
          </a>
          <a href="https://linkedin.com/in/bokaif" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-pill">
            <span class="iconify" data-icon="mdi:linkedin"></span>
          </a>
          <a href="https://behance.net/bokaif" target="_blank" rel="noopener noreferrer" aria-label="Behance" class="social-pill">
            <span class="iconify" data-icon="mdi:behance"></span>
          </a>
          <span class="separator">|</span>
          <a href="#" id="topbar-resume" target="_blank" rel="noopener noreferrer" class="social-pill" aria-label="Resume">
            <span class="iconify" data-icon="mdi:file-document-outline"></span>
          </a>
        </div>
      </header>
      <main id="main-scroll">
        <slot />
      </main>
      <div class="nav-wrapper">
        <div class="nav-cutout"></div>
        <nav id="floating-nav" class="floating-nav" aria-label="Portfolio sections">
          <a href="#about">about</a>
          <a href="#experience">experience</a>
          <a href="#projects">projects</a>
          <a href="#writing">words</a>
        </nav>
      </div>
    </div>
    <div class="custom-scrollbar">
      <div class="scrollbar-track" id="scrollbar-track">
        <div class="scrollbar-thumb" id="scrollbar-thumb"></div>
      </div>
    </div>
    <script src="/scripts/grained.js" defer></script>
    <script src="/scripts/main.js" defer></script>
  </body>
</html>
